
export const JUST = (value) => ({
    tag: "JUST",
    value,
    map: (fn) => JUST(fn(value)),
    chain: (fn) => fn(value),
    getOrElse: (fn) => value
});

export const NOTHING = () => ({
    tag: "NOTHING",
    map: () => NOTHING(),
    chain: () => NOTHING(),
    getOrElse: (fn) => fn()
});

export const of = JUST;
export const fromNullable = (val) => (val === null || val === undefined) ? NOTHING() : JUST(val);
